#include <iostream>
using namespace std;

int main() {
    int n;

    do {
        cout << "Masukkan ukuran (ganjil): ";
        cin >> n;
    } while (n % 2 == 0);

    for (int i = 1; i <= n; i++) {

        for (int j = 1; j <= n; j++) {

            if (i == 1 || i == n || j == 1 || j == n) {
                cout << "* ";
            }
            else if (i == n / 2 + 1 && j == n / 2 + 1) {
                cout << "* ";
            }
            else {
                cout << "  ";
            }

        }

        cout << endl;
    }

    return 0;
}
