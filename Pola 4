#include <iostream>
using namespace std;

int main() {
    int n;

    do {
        cout << "Masukkan ukuran (ganjil): ";
        cin >> n;
    } while (n % 2 == 0);

    for (int i = 0; i < n; i++) {

        for (int j = 0; j < n; j++) {

            if (j == i || j == n - i - 1) {
                cout << "* ";
            } else {
                cout << "  ";
            }

        }

        cout << endl;
    }

    return 0;
}
