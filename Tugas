
#include <iostream>
using namespace std;

int main() {
    int bilangan, total = 0;

    cout << "Masukkan bilangan (0 untuk berhenti): ";
    cin >> bilangan;

    while (bilangan != 0) {
        total += bilangan;

        cout << "Masukkan bilangan (0 untuk berhenti): ";
        cin >> bilangan;
    }

    cout << "Total seluruh bilangan: " << total << endl;

    return 0;
}
