#include <iostream>
using namespace std;

int main() {
    int n;

    do {
        cout << "Masukkan ukuran (ganjil): ";
        cin >> n;
    } while (n % 2 == 0);

    // Bagian atas
    for (int i = 1; i <= n; i += 2) {

        // Spasi
        for (int j = 0; j < (n - i); j++) {
            cout << " ";
        }

        // Bintang
        for (int j = 0; j < i; j++) {
            cout << "* ";
        }

        cout << endl;
    }

    // Bagian bawah
    for (int i = n - 2; i >= 1; i -= 2) {

        // Spasi
        for (int j = 0; j < (n - i); j++) {
            cout << " ";
        }

        // Bintang
        for (int j = 0; j < i; j++) {
            cout << "* ";
        }

        cout << endl;
    }

    return 0;
}
